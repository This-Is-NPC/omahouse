# omahouse — what a package cannot do from a file list.
#
# Four things: the two directories of docs/design.md §4, the service of §9, and the one
# line of PAM that makes `logout` mean anything at all (§2). The last is the only
# one that edits a file this package does not own, and it is the reason this
# script is longer than it looks like it should be.
#
# Everything here is idempotent. It runs again on every upgrade, and a machine
# that already has the line has to come out of it unchanged -- including one
# where somebody moved the line by hand, which is theirs to have done.
#
# And removal is not an afterthought here, it is half the job. omahouse puts four
# things on a machine that a file list cannot take back off it: the PAM line, the
# `blocked` list that line reads, the browser policy of §11, and an enabled
# service. Every one of them is a restriction, and a restriction that outlives
# the program that made it is worse than one that never existed -- there is no
# longer anything on the machine that knows how to lift it. `post_remove` below
# takes all four, in that spirit, and says what it kept.

_pam_file=/etc/pam.d/system-login
_pam_marker='pam_listfile.so.*file=/etc/omahouse/blocked'

# The line poc/findings.md round 3 measured, and the only shape of it that is
# ever written.
#
#   account required pam_listfile.so item=user sense=deny \
#           file=/etc/omahouse/blocked onerr=succeed
#
# `onerr=succeed` is NOT OPTIONAL, and it is not a preference. It is what makes a
# missing or unreadable /etc/omahouse/blocked let everybody in. Without it, a
# file that is not there yet -- which is every machine between this scriptlet and
# the first time somebody runs out of time -- would refuse every login on the
# system, at the console, with no way in to fix it. The same reasoning runs
# through the whole of omahouse: the failure that leaves the rules soft is
# recoverable, and the one that leaves them hard is not. docs/design.md §2 and §4 both
# say it, and this is the place where getting it wrong costs somebody their
# machine rather than an afternoon.
_pam_line='account    required   pam_listfile.so item=user sense=deny file=/etc/omahouse/blocked onerr=succeed'

_install_pam_line() {
    if [ ! -f "$_pam_file" ]; then
        cat >&2 <<-MESSAGE
		>>> omahouse: $_pam_file is not there, so the login block was not installed.
		>>>           Budgets with onExhausted "logout" will end the session and not
		>>>           stop the next login. Add this line to your PAM login stack:
		>>>
		>>>           $_pam_line
		MESSAGE
        return
    fi

    # Already there, however it got there. A second copy would refuse the same
    # people twice and would be one more line for the next upgrade to remove.
    if grep -Eq "^[^#]*$_pam_marker" "$_pam_file"; then
        return
    fi

    # Before every other `account` line, so that a refusal happens before
    # anything else in the stack has a chance to succeed.
    local temporary
    temporary="$(mktemp "${_pam_file}.omahouse.XXXXXX")" || return
    awk -v line="$_pam_line" '
        !done && /^[[:space:]]*account[[:space:]]/ { print line; done = 1 }
        { print }
        END { if (!done) print line }
    ' "$_pam_file" > "$temporary" || { rm -f "$temporary"; return; }

    # A truncated PAM file is a machine nobody can log into, so the new one is
    # checked for the line it was supposed to gain and for the lines it was
    # supposed to keep before it replaces anything.
    if [ "$(wc -l < "$temporary")" -le "$(wc -l < "$_pam_file")" ] \
        || ! grep -Eq "^[^#]*$_pam_marker" "$temporary"; then
        rm -f "$temporary"
        echo ">>> omahouse: could not edit $_pam_file; it was left alone." >&2
        return
    fi

    chmod --reference="$_pam_file" "$temporary" 2>/dev/null || chmod 0644 "$temporary"
    chown --reference="$_pam_file" "$temporary" 2>/dev/null || true
    mv -f "$temporary" "$_pam_file"
}

_remove_pam_line() {
    [ -f "$_pam_file" ] || return
    grep -Eq "^[^#]*$_pam_marker" "$_pam_file" || return

    local temporary
    temporary="$(mktemp "${_pam_file}.omahouse.XXXXXX")" || return
    grep -Ev "^[^#]*$_pam_marker" "$_pam_file" > "$temporary" || { rm -f "$temporary"; return; }
    chmod --reference="$_pam_file" "$temporary" 2>/dev/null || chmod 0644 "$temporary"
    chown --reference="$_pam_file" "$temporary" 2>/dev/null || true
    mv -f "$temporary" "$_pam_file"
}

_directories() {
    # 0644 files in 0755 directories -- docs/design.md §4. Root writes both and
    # everybody reads them, which is what lets the fiscalised user run
    # `omahouse status` and see what is left of their own day.
    install -d -m 0755 /etc/omahouse
    install -d -m 0755 /var/lib/omahouse
}

post_install() {
    _directories
    _install_pam_line

    # Enabled, and not started. A daemon that begins counting inside a pacman
    # transaction is a daemon nobody chose to run yet, and there are no profiles
    # on a machine that has just installed this -- `watch` would find an empty
    # list and say so. It starts at the next boot, or when somebody asks.
    #
    # Enabling at all is the deliberate part: docs/design.md §9. A stopped daemon is a
    # rule switched off, and this package exists to be a rule.
    systemctl enable omahouse.service >/dev/null 2>&1 || true

    # Quoted delimiter. The text below names verbs in backticks, and an
    # unquoted heredoc would run them: measured on a real Omarchy install, where
    # `pacman -U` executed `omahouse profile enforce` out of its own welcome
    # message and printed a parse error for the `<user>` it read as a redirect.
    # Nothing here needs expansion, so nothing here gets it.
    cat <<-'MESSAGE'
	>>> omahouse: /etc/omahouse and /var/lib/omahouse are ready, and
	>>>           omahouse.service is enabled for the next boot.
	>>>
	>>>           Nobody is under rules yet. Start with:
	>>>             omahouse profile add <user> --name "Name"
	>>>             omahouse status <user>
	>>>
	>>>           A new profile only counts and reports. Read a day of
	>>>           `omahouse report <user>` before `omahouse profile enforce
	>>>           <user> --on` puts the teeth in.
	MESSAGE
}

post_upgrade() {
    _directories
    # Again on every upgrade, because a PAM file replaced by a .pacnew merge is a
    # machine where the line quietly went away and nothing else would notice.
    _install_pam_line
}

pre_remove() {
    systemctl disable --now omahouse.service >/dev/null 2>&1 || true
}

post_remove() {
    _remove_pam_line

    # And the list itself, always, whatever else is kept.
    #
    # This is the one thing in this file that must not be left behind. A machine
    # with a name still in /etc/omahouse/blocked and no omahouse installed is a
    # machine where nothing can ever take that name back out -- the daemon that
    # would have done it at the turn of the day is gone. Removing the package has
    # to be a way out, not a way to make the lock permanent.
    rm -f /etc/omahouse/blocked

    # The browser policy of docs/design.md §11, for exactly the same reason.
    #
    # A site blocked by omahouse is blocked by a file in another program's
    # directory, and Chromium goes on reading that file whether or not omahouse
    # is installed. Leaving it would be a machine where a site does not open, the
    # browser says "managed by your organisation", and there is no longer any
    # program on the disk that could explain it or undo it. Somebody would be
    # editing JSON in /etc by hand to get YouTube back.
    #
    # Removed by name, and only by name. This directory belongs to the browser
    # and Omarchy's own `browser-policy.sh` writes `policies.json` beside ours;
    # anything not called omahouse.json is somebody else's and is left exactly
    # where it is. The directory itself is not removed either -- it existed
    # before this package and it is not ours to take.
    rm -f /etc/chromium/policies/managed/omahouse.json

    cat <<-'MESSAGE'
	>>> omahouse: everything omahouse put on this machine is off it.
	>>>
	>>>           The login block is gone and everybody can log in again, the
	>>>           browser policy in /etc/chromium/policies/managed/omahouse.json
	>>>           is gone and every site opens again, and the service is stopped
	>>>           and disabled. No rule omahouse wrote is still in force.
	>>>
	>>>           Two things were kept on purpose, and here is where they are:
	>>>             /etc/omahouse/profiles.json   who was under rules
	>>>             /var/lib/omahouse/            the days already counted
	>>>           A report is evidence, and it outlives the rules it was
	>>>           collected under. Neither of them does anything to the machine
	>>>           now; `rm -rf` both if you want the account back to nothing.
	MESSAGE
}
