# The omakure this suite installs, wrapped as the package a household would get.
#
# Not omakure's own packaging and never a substitute for it: omakure is its own
# product with its own repository, and when the `omarchy` repo carries it this
# file goes away. What it exists for is one thing the suite has to be able to
# prove -- that `omahouse machine link` really installs omahouse on a computer
# that has none, through `pacman -S`, with its dependency resolved the way
# pacman resolves dependencies.
#
# Without it, `depends=('omakure')` would make that install impossible in a VM,
# and the case would have to reach around the package manager to prove something
# about the package manager.
#
# The binary is the statically linked one built from the checkout beside this,
# handed in by the harness. Same discipline as omahouse's own PKGBUILD: there is
# no tarball and no tag here, this is the working copy under test.
pkgname=omakure
pkgver=0.0.0
pkgrel=1
pkgdesc="Fleet plane for Omarchy machines (built from the checkout under test)"
arch=('x86_64')
url="https://github.com/This-Is-NPC/omakure"
license=('MIT')
# Statically linked against musl, so it needs nothing.
depends=()
options=('!strip')
source=()

package() {
  install -Dm755 "$startdir/omakure" "$pkgdir/usr/bin/omakure"
}
